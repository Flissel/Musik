# Kopie als .env anlegen und ausfüllen. .env ist in .gitignore — Keys gehören
# niemals ins Repo.

# --- Musikgenerierung ---------------------------------------------------

# ElevenLabs Music — vorgesehener Startadapter (siehe docs/APIS.md)
ELEVENLABS_API_KEY=

# Suno — aktuell KEINE öffentliche API verfügbar (Stand August 2026).
# Platzhalter für den Fall, dass die Bewerbung beim Partner-Programm
# durchgeht. Bis dahin leer lassen.
SUNO_API_KEY=

# Stable Audio (Stability AI) — Alternative für instrumentale Texturen
STABILITY_API_KEY=

# --- Samples ------------------------------------------------------------

# Freesound APIv2 — kostenlos für nicht-kommerzielle Nutzung
FREESOUND_API_KEY=

# --- Lokale Pfade -------------------------------------------------------

# Wohin generierte Tracks geschrieben werden
GENERATED_DIR=./generated

# Bestehende Traktor-Sammlung für den Import (docs/TRAKTOR-REFERENZ.md)
# TRAKTOR_COLLECTION_PATH=
